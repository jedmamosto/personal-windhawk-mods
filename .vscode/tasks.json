{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Windhawk: Verify Syntax (Active File)",
      "type": "shell",
      "command": "C:\\Program Files\\Windhawk\\Compiler\\bin\\clang++.exe",
      "args": [
        "-fsyntax-only",
        "-std=c++20",
        "-DUNICODE",
        "-D_UNICODE",
        "-DWH_MOD",
        "-DWH_MOD_ID=L\"${fileBasenameNoExtension}\"",
        "-I\"C:\\Program Files\\Windhawk\\Compiler\\include\"",
        "-I\"${fileDirname}\"",
        "-include",
        "windhawk_api.h",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
